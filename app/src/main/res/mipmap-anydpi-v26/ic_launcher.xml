<?xml version="1.0" encoding="utf-8"?>
<!-- Background is a flat colour, foreground carries the artwork. This is the shape every
     production app ships: the earlier version put a JPEG in the background layer and left
     the foreground empty, which some launchers (One UI in particular) render blank. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
