<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Two values: the light variant matches globals.css :root window colour (#f2f2f7), the
         night variant matches the dark window colour (#0b0b0e), so the pre-Compose window
         background never flashes the wrong colour on launch. -->
    <style name="Theme.Musiku" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
